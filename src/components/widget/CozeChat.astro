---
/**
 * CozeChat.astro — 博客 AI 助手浮窗（静态壳）+ AgentChat.svelte（自建聊天窗控制器）
 *
 * M3 重构：原实现直接用 Coze Web SDK 渲染聊天窗，SDK 不透传 function_call/tool_response，
 * 拿不到「对暗号」换取的每日 JWT。现改为：
 * - 本组件保留自建悬浮球 + 问候气泡（HTML/CSS 原样，跨页存活于 #swup-container 外）
 * - 聊天窗面板 + 全部逻辑交给 AgentChat.svelte（client:load 一次性挂载，无内联脚本，
 *   不受 SwupScriptsPlugin 切页重跑影响）
 * - 双 agent（Coze 博客助手 + Dify 智库）并行状态，点击切换；对暗号 → 解析 tool_response
 *   取得每日 JWT → 解锁 Dify（大闸门）
 *
 * 依赖: AgentChat.svelte（Svelte 5 runes，直连 Coze v3 SSE + 后端 Dify 代理）
 */
import AgentChat from "@components/widget/AgentChat.svelte";

const BOT_ID = "7664222715091370036";
const API_BASE = "/api/coze"; // coze-gateway 后端（token 签发，微服务拆出 Dify 后不再代 Dify）
const API_DIFY = "/api/dify"; // dify-gateway 独立服务（每日 JWT 大闸门 + Dify SSE 代理）
const COZE_API_BASE = "https://api.coze.cn"; // 浏览器直连 Coze Chat API v3
---

<!-- ===== 自建悬浮球 + 问候气泡（逻辑由 AgentChat.svelte 绑定） ===== -->
<div id="coze-widget" class="coze-widget">
  <!-- 问候气泡：位于悬浮球上方，带指向球的尾巴 -->
  <div id="coze-bubble" class="coze-bubble" role="status">
    <span>hi~请问有什么问题吗？</span>
    <button id="coze-bubble-close" class="coze-bubble-close" type="button" aria-label="关闭">×</button>
    <button id="coze-bubble-never" class="coze-bubble-never" type="button">不再显示</button>
  </div>
  <!-- 悬浮球：默认半隐藏，悬停跳出。
       hover 判定框（.coze-hitbox）固定不动，覆盖球静止时的可见条带；
       球本体只做视觉位移。这样动画途中鼠标始终停留在判定框内，
       不会因为球上移脱离鼠标而反复"弹出-缩回"抖动。 -->
  <div id="coze-hitbox" class="coze-hitbox">
    <button id="coze-ball" class="coze-ball" type="button" aria-label="打开 AI 助手">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
    </button>
  </div>
</div>

<style is:global>
  /* ===== 自建悬浮球 + 问候气泡 =====
     主题变量来自 src/styles/variables.styl；暗色模式靠 html.dark 自动切换 */
  .coze-widget {
    position: fixed;
    right: 1rem;
    bottom: 0;
    width: 0;
    height: 0;
    z-index: 1010; /* 高于 FloatingControls/SDK 容器(1000)，低于 Toast(9999) */
    pointer-events: none; /* 容器不拦截点击，子元素各自可点 */
  }
  .coze-widget .coze-hitbox,
  .coze-widget .coze-bubble { pointer-events: auto; }

  /* --- 悬浮球：半隐藏于右下角 ---
     hover 判定框（.coze-hitbox）固定不动，覆盖球静止时的可见条带；
     球本体只做视觉位移。动画途中鼠标始终停留在判定框内，
     不会因球上移脱离鼠标而反复"弹出-缩回"抖动。 */
  .coze-hitbox {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 56px;
    height: 40px; /* 覆盖静止条带(28px)+余量；顶不高过 FloatingControls(bottom:64px) */
    pointer-events: auto;
  }
  .coze-ball {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 56px;
    height: 56px;
    transform: translateY(28px); /* 静止：下半截压出视口 = 只露上半 28px */
    border-radius: var(--radius-full);
    border: 1px solid var(--line-divider);
    background: var(--card-bg);
    color: var(--primary);
    box-shadow: var(--shadow-button);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    will-change: transform;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); /* 带回弹 = 跳出来 */
  }
  .coze-hitbox:hover .coze-ball,
  .coze-ball:focus-visible {
    transform: translateY(-16px); /* 弹出：完整可见，底部留 16px */
  }
  .coze-hitbox:active .coze-ball { transform: translateY(-16px) scale(0.9); }

  /* 气泡显示期间，球弹出到完整位（09 模板形态：尾巴对准球顶） */
  .coze-widget.coze-has-bubble .coze-ball { transform: translateY(-16px); }

  /* 聊天窗打开 → 整组隐藏（AgentChat.svelte 切换 coze-chat-open） */
  .coze-widget.coze-chat-open {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-standard);
  }

  /* --- 问候气泡（模板 09：圆体大圆角，主题色卡片） ---
     底色/描边用 color-mix 以 --primary 调出淡主题色（跟随站点主题色相 --hue，
     含用户自选主题色）；底色随 --card-bg、描边随 --line-divider 自动适配亮暗，
     仅文字色需 html.dark 覆盖（--deep-text 在暗色下仍是深色值）。
     必须显式 width:max-content：容器 width:0 下仅设 right 的绝对定位子元素
     会 shrink-to-fit 坍缩成 ~58px 窄条（此前"字体难看"的根因）。 */
  .coze-bubble {
    --bubble-bg: color-mix(in oklab, var(--primary) 10%, var(--card-bg));
    --bubble-border: color-mix(in oklab, var(--primary) 30%, var(--line-divider));
    position: absolute;
    right: 32px; /* 悬浮球左上方 */
    bottom: 84px;
    width: max-content; /* 修坍缩 bug：显式非 auto 宽度，避开 shrink-to-fit */
    max-width: 230px;
    padding: 12px 14px;
    border-radius: 20px; /* 大圆角 */
    background: var(--btn-regular-bg); /* 不支持 color-mix 时的降级 */
    background: var(--bubble-bg);
    border: 1px solid var(--line-divider); /* 降级 */
    border: 1px solid var(--bubble-border);
    box-shadow: var(--shadow-md); /* 降级 */
    box-shadow: 0 8px 20px color-mix(in oklab, var(--primary) 16%, transparent);
    color: var(--deep-text);
    font-family: "MiSans", "HarmonyOS Sans SC", "PingFang SC", "Microsoft YaHei",
      system-ui, sans-serif; /* 圆体字 */
    font-size: 14px;
    line-height: 1.5;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap; /* 允许「不再显示」换行到第二行 */
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px) scale(0.96);
    transition: opacity var(--duration-medium) var(--ease-standard),
      transform var(--duration-medium) var(--ease-decelerate),
      visibility var(--duration-medium);
  }
  html.dark .coze-bubble { color: var(--btn-content); } /* 暗色用浅主题色文字 */
  .coze-bubble > span { flex: 1 1 auto; line-height: 1.5; } /* 文案占满，× 靠右 */
  .coze-bubble-never {
    flex-basis: 100%; /* 独立一行，右对齐 */
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    opacity: 0.55;
    font-size: 12px;
    text-align: right;
    cursor: pointer;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }
  .coze-bubble-never:hover { opacity: 1; }

  .coze-bubble.coze-bubble-show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  /* 尾巴：指向悬浮球（09 模板：right 20px / 14px 方块） */
  .coze-bubble::after {
    content: "";
    position: absolute;
    right: 20px;
    bottom: -8px;
    width: 14px;
    height: 14px;
    background: var(--btn-regular-bg); /* 降级 */
    background: var(--bubble-bg);
    border-right: 1px solid var(--line-divider); /* 降级 */
    border-right: 1px solid var(--bubble-border);
    border-bottom: 1px solid var(--line-divider); /* 降级 */
    border-bottom: 1px solid var(--bubble-border);
    transform: rotate(45deg);
  }
  .coze-bubble-close {
    flex-shrink: 0;
    border: none;
    background: none;
    padding: 2px;
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    color: inherit;
    opacity: 0.45;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }
  .coze-bubble-close:hover { opacity: 1; }

  /* --- 移动端（48px 球等比缩放） --- */
  @media (max-width: 768px) {
    .coze-hitbox { width: 48px; height: 32px; }
    .coze-ball { width: 48px; height: 48px; transform: translateY(24px); }
    .coze-hitbox:hover .coze-ball,
    .coze-ball:focus-visible { transform: translateY(-12px); }
    .coze-widget.coze-has-bubble .coze-ball { transform: translateY(-12px); }
    .coze-bubble {
      right: 24px;
      bottom: 40px; /* 尾巴对准弹出后的 48px 球顶 */
      width: max-content;
      max-width: 190px;
    }
    .coze-bubble::after { right: 14px; }
  }
  /* 触摸设备没有 hover → 直接完整露出 */
  @media (hover: none) and (pointer: coarse) {
    .coze-ball { transform: translateY(-16px); }
    .coze-widget.coze-has-bubble .coze-ball { transform: translateY(-16px); }
  }
</style>

<!-- ===== 自建聊天窗控制器（client:load 挂载；跨页存活于 #swup-container 外） ===== -->
<AgentChat client:load botId={BOT_ID} apiBase={API_BASE} difyApiBase={API_DIFY} cozeApiBase={COZE_API_BASE} />
