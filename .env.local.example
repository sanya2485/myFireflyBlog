# 复制为 .env.local 并填写真实值（.env.local 已被 gitignore，不会进公开仓库）
# 服务器 IP/域名（必填）
BLOG_SERVER_HOST=YOUR_SERVER_IP
# 登录用户（默认 root）
BLOG_SERVER_USER=root
# SSH 私钥路径（默认使用 ~/.ssh 默认密钥；如需指定则取消注释）
# BLOG_SSH_KEY=C:/Users/YOU/.ssh/id_rsa
# 服务器目标目录（默认 /root/cc/files）
# BLOG_FILES_REMOTE_DIR=/root/cc/files
# 博客线上地址（用于打印下载链接）
BLOG_URL=https://www.sanyablog.cn
# 上传失败重试次数与间隔（可选，默认 3 次 / 5 秒；多次失败后脚本报错并给出人工介入指引）
# BLOG_UPLOAD_MAX_RETRY=3
# BLOG_UPLOAD_RETRY_DELAY=5
