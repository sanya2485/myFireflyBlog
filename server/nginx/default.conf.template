# ============================================
# myFireflyBlog — nginx 生产配置
# 域名:     www.sanyablog.cn（裸域 sanyablog.cn 301 → www）
# HTTPS:    Let's Encrypt / 阿里云免费证书
# 管理方式: 通过 deploy-nginx.yml workflow 独立部署
# 路径:     /root/cc/nginx/conf/default.conf
# 挂载:     -v /root/cc/nginx/conf/default.conf:/etc/nginx/conf.d/default.conf:ro
# SSL:      -v /root/cc/nginx/ssl:/etc/nginx/ssl:ro
# 双槽蓝绿: 容器 html 顶层挂 /root/cc/blog（内含 current 相对软链 + releases/slot-a|b）；
#           本 server 内容 root 固定为 /usr/share/nginx/html/current → 原子换链即切流。
#           附件 /files/ 独立 alias 回顶层 html/files（嵌套 bind /root/cc/files），与活动槽解耦。
# ============================================

# ============================================
# 文件下载限流（http 级 zone 定义）
# 同一 IP 对 /files/ 下载请求的平均频率限制（防刷 / 防盗链）
# zone: file_download，10m 内存 ≈ 可记录约 16 万个 IP
# ============================================
limit_req_zone $binary_remote_addr zone=file_download:10m rate=5r/s;

# ============================================
# HTTP → HTTPS 重定向
# ============================================
server {
    listen       80;
    listen  [::]:80;
    server_name  ${BLOG_DOMAIN};

    # 301 永久重定向到 HTTPS
    return 301 https://$host$request_uri;
}

# ============================================
# HTTP → HTTPS 重定向（裸域 sanyablog.cn → www）
# 证书 SAN 已同时覆盖 sanyablog.cn 与 www.sanyablog.cn，复用同一份证书
# ============================================
server {
    listen       80;
    listen  [::]:80;
    server_name  sanyablog.cn;

    # 直接一步跳到 www，避免二次跳转
    return 301 https://www.sanyablog.cn$request_uri;
}

# ============================================
# HTTPS 服务器
# ============================================
server {
    listen       443 ssl;
    listen  [::]:443 ssl;
    http2 on;
    server_name  ${BLOG_DOMAIN};

    # SSL 证书
    ssl_certificate     /etc/nginx/ssl/www.sanyablog.cn.pem;
    ssl_certificate_key /etc/nginx/ssl/www.sanyablog.cn.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    root   /usr/share/nginx/html/current;  # 双槽蓝绿：current = 宿主 /root/cc/blog/current 相对软链 → releases/slot-a|b，换链即切流
    index  index.html;

    # ============================================
    # Gzip 压缩
    # ============================================
    gzip on;
    gzip_min_length 1000;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml;
    gzip_vary on;
    gzip_disable "msie6";

    # ============================================
    # 安全头
    # ============================================
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # HSTS — 强制浏览器始终使用 HTTPS
    add_header Strict-Transport-Security "max-age=2592000" always;

    # ============================================
    # 缓存策略
    # 博客为 Astro 构建，_astro/ 目录内容经过 hash
    # ============================================

    # Astro 构建产物（hash 文件名）— 不可变缓存
    location /_astro/ {
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    # 通用静态资源
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public";
    }

    # Pagefind 搜索索引
    location /pagefind/ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # RSS / 站点地图
    location ~* \.(rss|xml)$ {
        expires 1h;
        add_header Cache-Control "public";
    }

    # HTML 页面 — 禁止缓存（必须每次都从服务器获取最新内容）
    location ~* \.html$ {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # ============================================
    # 文件下载（随文附件）
    # /files/ 目录由宿主机 /root/cc/files 挂载（独立于 git 部署内容，
    # 由 scripts/upload-files.sh 上传）。此处加两层限流：
    #   1. 请求频率限流 —— 同 IP 平均 5 r/s，突发 20，超出返回 429
    #   2. 下载速度限速 —— 前 8MB 全速，之后每连接限速 2MB/s
    # 参数可按需调整（rate / burst / limit_rate / limit_rate_after）。
    # ============================================
    # ^~ 阻断下方 \.(rss|xml)$ 与 \.html$ 正则抢走 /files/ 子树；
    # alias 把 /files/* 从 current 槽解耦，永远回嵌套 bind 挂载点 html/files（宿主机 /root/cc/files）。
    # alias 首尾都必须带斜杠（缺尾斜杠会把 /files/x 拼成 …/filesx）。
    location ^~ /files/ {
        limit_req zone=file_download burst=20 nodelay;
        limit_req_status 429;

        limit_rate_after 8m;
        limit_rate 2m;

        # 附件不缓存，确保每次下载都能拿到最新文件
        add_header Cache-Control "no-store, must-revalidate";
        alias /usr/share/nginx/html/files/;
    }

    # 蓝绿槽内部目录(releases/)：候选槽在切流前不得对外可访问(也免 SEO 重复内容)
    location ^~ /releases/ {
        return 404;
    }

    # ============================================
    # 错误页面
    # ============================================
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        # 无自带 root → 继承 server root=current；槽内必须自带 50x.html（public/50x.html 随 build 打进 dist）
        internal;
    }

    # ============================================
    # Dify 独立服务 API 网关（微服务拆分）
    #
    # dify 与 coze 解耦：/api/dify/ 转发到独立容器 dify-gateway:8081，
    # Coze 服务（coze-gateway）故障不影响 Dify。前端持每日 JWT 走 /api/dify/chat。
    # ============================================
    location /api/dify/ {
        proxy_pass http://dify-gateway:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 后端返回 401/429 时不缓存，透传到客户端
        proxy_no_cache 1;
        proxy_cache_bypass 1;

        # SSE 长连接：Dify 流式透传，超时须放大
        proxy_read_timeout 120s;
    }

    # ============================================
    # xxl-job-admin 调度中心（微服务编排）
    #
    # xxl-job-admin 容器自身的 Spring 上下文是 /xxl-job-admin（见其启动日志/应用配置），
    # 所以 proxy_pass 必须不带尾斜杠：不加 URI 时 nginx 会原样透传完整请求 URI，
    # 浏览器访问 /xxl-job-admin/... → 转发到容器 /xxl-job-admin/...，正好命中应用上下文。
    # 若写成 /8080/（带尾斜杠）会把 /xxl-job-admin 前缀剥掉转成容器根 /，导致 404。
    # （coze-gateway executor 直接经 coze-net 回调容器，不走 nginx，与这里的上下文路径无关。）
    # ============================================
    location /xxl-job-admin/ {
        proxy_pass http://xxl-job-admin:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # ============================================
    # Coze AI 助手 API 网关
    #
    # 博客容器与后端容器通过 coze-net 共享 Docker 网络互联，
    # 使用容器名 coze-gateway:8080 通信。
    #
    # 认证方式: 后端 OAuth JWT Token，Nginx 层不再做 IP 白名单拦截。
    # ============================================
    location /api/coze/ {
        # ---- 反向代理到后端 ----
        proxy_pass http://coze-gateway:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 后端返回 403/429/503 时不缓存，透传到客户端
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # ============================================
    # 每日暗号鉴权 API
    #
    # /api/auth/verify（暗号校验 → 签发每日 JWT）与 /api/auth/code（查暗号）
    # 代理到 coze-gateway。鉴权靠后端 X-Auth-Secret 头校验
    # （Coze 工作流 HTTP 节点携带），浏览器无该头 → 403，不可直达。
    # ============================================
    location /api/auth/ {
        proxy_pass http://coze-gateway:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # ============================================
    # 私有 PyPI（pypi-server）
    #
    # 博客容器与 pypi-server 通过 coze-net 共享 Docker 网络互联，
    # 使用容器名 pypi-server:8081 通信。
    #
    # 认证方式: pypi-server 自身 htpasswd（-P），本层透传 Authorization 头。
    # 访问形态: https://<domain>/pypi/simple/ 及 twine 上传到 /pypi/
    # ============================================
    location /pypi/ {
        proxy_pass http://pypi-server:8081/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 包文件下载：pypiserver 生成的链接是 /packages/... 绝对路径，
    # 保持 URI 原样转发（proxy_pass 不带尾斜杠）
    location /packages/ {
        proxy_pass http://pypi-server:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ============================================
    # 安全：禁止访问隐藏文件
    # ============================================
    location ~ /\. {
        deny all;
    }
}

# ============================================
# HTTPS 裸域 → www 重定向
# 放在主 HTTPS 块之后，避免影响 IP 直连时默认回落（第一个 443 块）的行为
# 复用 www.sanyablog.cn 证书（SAN 已覆盖裸域）
# ============================================
server {
    listen       443 ssl;
    listen  [::]:443 ssl;
    http2 on;
    server_name  sanyablog.cn;

    ssl_certificate     /etc/nginx/ssl/www.sanyablog.cn.pem;
    ssl_certificate_key /etc/nginx/ssl/www.sanyablog.cn.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # 301 永久重定向到 www
    return 301 https://www.sanyablog.cn$request_uri;
}
